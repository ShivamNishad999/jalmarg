# URL of the deployed backend. Leave empty in local dev (Vite proxies /api to localhost:8080).
VITE_API_BASE=

# Default false. Set true ONLY after the deployment operator has verified
# GET /api/reports/{id}/evidence.pdf on this backend (200 application/pdf).
# This is an explicit deployment assertion, not automatic capability detection.
VITE_INCIDENT_PDF_VERIFIED=false
