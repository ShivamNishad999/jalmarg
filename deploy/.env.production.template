# ==================================================================================
# JALMARG PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# Target Database: jalmarg_twin on PostGIS port 5433
# STRICT REQUIREMENT: CarSync port 5432 is strictly prohibited and isolated!
# ==================================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL + PostGIS Target Database
DB_URL=jdbc:postgresql://127.0.0.1:5433/jalmarg_twin
DB_USER=postgres
DB_PASSWORD=your_secure_postgis_password_here
DB_POOL_MAX=15
DB_POOL_MIN_IDLE=3

# Municipal Authority Security Keys (Replace with cryptographically generated keys)
ADMIN_KEY=change_this_to_a_random_64_char_authority_key
ALERT_RUN_KEY=change_this_to_a_random_64_char_alert_cron_key

# Photo Storage Configuration
# Set S3_BUCKET for AWS S3 storage; leave blank for local disk storage (./uploads)
S3_BUCKET=
LOCAL_UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://jalmarg.delhi.gov.in,http://localhost:5173

# Operational Controls
REPORT_TTL_HOURS=6
DEMO_ISOLATED_MODE=true
SEED_ENABLED=false
COPERNICUS_DEM_ENABLED=true
NASA_IMERG_ENABLED=false

# Computer Vision Deployment (Preserve Licensing Gate)
# Keep false until formal academic copyright clearance is resolved
VISION_ENABLED=false
