# Copy to .env (never commit .env). All are optional for local runs.

# --- Database (Amazon RDS MySQL). Leave unset to use the built-in H2 file DB.
# DB_URL=jdbc:mysql://<rds-endpoint>:3306/jalmarg?createDatabaseIfNotExist=true&useSSL=true
# DB_USER=admin
# DB_PASSWORD=

# --- AWS
AWS_REGION=ap-south-1
AI_ENABLED=false
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# BEDROCK_REGION=ap-south-1
S3_BUCKET=
SNS_TOPIC_ARN=

# --- App
CORS_ORIGINS=http://localhost:5173,https://*.amplifyapp.com,https://localhost,capacitor://localhost
ALERT_RUN_KEY=change-me
SEED_ENABLED=true
REPORT_TTL_HOURS=6
CLEAR_VOTES=5

# --- Accounts & email OTP
# SMTP for verification / reset codes. Amazon SES SMTP or a Gmail App Password both work.
# MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=JalMarg <no-reply@your-verified-domain>
# Local development only: print OTP codes to the backend console instead of emailing them.
# Never enable on a public server.
JALMARG_DEV_OTP=false
SESSION_DAYS=30
# Optional: create/upgrade one ADMIN account on start-up (use a strong, unique password).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
