# ==============================================================================
# JALMARG ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env for local deployment.
# NEVER commit .env containing real credentials, tokens or keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Active Profiles
# ------------------------------------------------------------------------------
PORT=8080
# Use 'postgis' for PostgreSQL/PostGIS, 'prod' for production, or leave default for H2
SPRING_PROFILES_ACTIVE=postgis

# ------------------------------------------------------------------------------
# 2. PostgreSQL / PostGIS Database Configuration
# Default local instance runs on isolated port 5433 to avoid standard port conflicts.
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://127.0.0.1:5433/jalmarg_twin
DB_USER=postgres
DB_PASSWORD=your_secure_postgis_password_here
DB_POOL_MAX=15
DB_POOL_MIN_IDLE=3

# ------------------------------------------------------------------------------
# 3. Administrative & Security Keys
# Cryptographically random strings (min 32 characters) for scheduled tasks & auth
# ------------------------------------------------------------------------------
ADMIN_KEY=your_random_64_char_admin_key_here
ALERT_RUN_KEY=your_random_64_char_alert_cron_key_here

# ------------------------------------------------------------------------------
# 4. Municipal Test User Credentials (For local development/testing only)
# In production, users should be provisioned via database migrations or identity provider.
# ------------------------------------------------------------------------------
OPERATOR_PASSWORD=
VIEWER_PASSWORD=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Storage & Cloud Integrations (Optional)
# ------------------------------------------------------------------------------
# Photo Storage: leave S3_BUCKET empty for local disk uploads (./uploads)
S3_BUCKET=
LOCAL_UPLOAD_DIR=./uploads
AWS_REGION=ap-south-1

# Optional Bedrock Multimodal Vision (Default: false)
AI_ENABLED=false
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# ------------------------------------------------------------------------------
# 6. Computer Vision & Research Feature Gates
# Keep VISION_ENABLED=false until dataset licensing clearance is established
# ------------------------------------------------------------------------------
VISION_ENABLED=false

# ------------------------------------------------------------------------------
# 7. Frontend Vite Configuration (Consumed by frontend dev/build server)
# ------------------------------------------------------------------------------
VITE_API_BASE=
VITE_INCIDENT_PDF_VERIFIED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
